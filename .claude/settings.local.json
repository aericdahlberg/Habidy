{
  "permissions": {
    "allow": [
      "Bash(npx tsc:*)",
      "Bash(awk '{print $1, $2, $11, $12}')",
      "Bash(node -e ':*)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(npm test:*)",
      "Bash(npx ts-node *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(npx tsx *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "notion"
  ]
}
